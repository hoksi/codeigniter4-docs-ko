msgstr "``greater_than[8]``"

#: ../../source/libraries/validation.rst:937
msgid "greater_than_equal_to"
msgstr "greater_than_equal_to"

#: ../../source/libraries/validation.rst:937
msgid "Fails if field is less than the parameter value, or not numeric."
msgstr "필드가 매개변수 값보다 작거나 숫자가 아니면 실패합니다."

#: ../../source/libraries/validation.rst:937
msgid "``greater_than_equal_to[5]``"
msgstr "``greater_than_equal_to[5]``"

#: ../../source/libraries/validation.rst:939
