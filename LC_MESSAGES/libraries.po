msgid "user_agent: ``$_SERVER['HTTP_USER_AGENT']`` (unused by sessions)"
msgstr "user_agent: ``$_SERVER['HTTP_USER_AGENT']`` (세션에서 사용하지 않음)"

#: ../../source/libraries/sessions.rst:407
msgid "last_activity: Depends on the storage, no straightforward way. Sorry!"
msgstr "last_activity: 저장 방식에 따라 다르며 간단한 방법이 없습니다. 죄송합니다!"

