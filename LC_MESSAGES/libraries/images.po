msgid "``$image->flatten()``"
msgstr "``$image->flatten()``"

#: ../../source/libraries/images.rst:113
msgid "``$image->flip()``"
msgstr "``$image->flip()``"

#: ../../source/libraries/images.rst:114
msgid "``$image->resize()``"
msgstr "``$image->resize()``"

#: ../../source/libraries/images.rst:115
msgid "``$image->rotate()``"
msgstr "``$image->rotate()``"

#: ../../source/libraries/images.rst:116
msgid "``$image->text()``"
msgstr "``$image->text()``"

