msgstr "``$image->crop()``"

#: ../../source/libraries/images.rst:110
msgid "``$image->convert()``"
msgstr "``$image->convert()``"

#: ../../source/libraries/images.rst:111
msgid "``$image->fit()``"
msgstr "``$image->fit()``"

