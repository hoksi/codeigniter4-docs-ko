msgstr ""

#: ../../source/libraries/uri.rst:164
msgid "Query values can only be set as a string currently."
msgstr ""

#: ../../source/libraries/uri.rst:169
msgid "The ``setQuery()`` method overwrites existing query variables."
msgstr ""

#: ../../source/libraries/uri.rst:171
msgid ""
"Query values cannot contain fragments. An InvalidArgumentException will "
"be thrown if it does."
msgstr ""

