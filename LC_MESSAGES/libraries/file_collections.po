msgid "addDirectory(string $directory, bool $recursive = false)"
msgstr ""

#: ../../source/libraries/file_collections.rst:93
msgid "addDirectories(array $directories, bool $recursive = false)"
msgstr ""

#: ../../source/libraries/file_collections.rst:95
msgid ""
"Adds all files from the directory or directories, optionally recursing "
"into sub-directories. Directories are absolute paths to actual "
"directories."
