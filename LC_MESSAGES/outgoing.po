msgstr "주어진 구문에서 단어 반경 내의 텍스트를 반환합니다. **발췌** 도우미 기능과 동일합니다."

#: ../../source/outgoing/view_parser.rst:381
#, python-brace-format
msgid "{ v|excerpt(green giant, 20) }"
msgstr "{ v|excerpt(green giant, 20) }"

#: ../../source/outgoing/view_parser.rst:384
msgid "highlight"
msgstr "가장 밝은 부분"

#: ../../source/outgoing/view_parser.rst:384
msgid "phrase"
msgstr "구절"

#: ../../source/outgoing/view_parser.rst:384
msgid "Highlights a given phrase within the text using '<mark></mark>' tags."
msgstr "'<mark></mark>' 태그를 사용하여 텍스트 내에서 특정 문구를 강조 표시합니다."

#: ../../source/outgoing/view_parser.rst:384
#, python-brace-format
msgid "{ v|highlight(view parser) }"
msgstr "{ v|highlight(view parser) }"

#: ../../source/outgoing/view_parser.rst:387
msgid "highlight_code"
msgstr "하이라이트_코드"

#: ../../source/outgoing/view_parser.rst:387
msgid "Highlights code samples with HTML/CSS."
msgstr "HTML/CSS로 코드 샘플을 강조 표시합니다."

#: ../../source/outgoing/view_parser.rst:387
#, python-brace-format
msgid "{ v|highlight_code }"
msgstr "{ v|highlight_code }"

#: ../../source/outgoing/view_parser.rst:389
msgid "limit_chars"
msgstr "한도_문자"

#: ../../source/outgoing/view_parser.rst:389
#: ../../source/outgoing/view_parser.rst:391
