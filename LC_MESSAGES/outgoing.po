msgstr "{ v|date_modify(+1 day) }"

#: ../../source/outgoing/view_parser.rst:376
msgid "default"
msgstr "기본"

#: ../../source/outgoing/view_parser.rst:376
msgid "default value"
msgstr "기본값"

#: ../../source/outgoing/view_parser.rst:376
msgid "Displays the default value if the variable is `empty()`_."
msgstr "변수가 `empty()`_\\인 경우 기본값을 표시합니다."

#: ../../source/outgoing/view_parser.rst:376
#, python-brace-format
msgid "{ v|default(just in case) }"
msgstr "{ v|default(just in case) }"

#: ../../source/outgoing/view_parser.rst:378
msgid "esc"
msgstr "에스"

#: ../../source/outgoing/view_parser.rst:378
msgid "html, attr, css, js"
msgstr "HTML, 속성, CSS, JS"

#: ../../source/outgoing/view_parser.rst:378
msgid "Specifies the context to escape the data."
msgstr "데이터를 이스케이프할 컨텍스트를 지정합니다."

#: ../../source/outgoing/view_parser.rst:378
#, python-brace-format
msgid "{ v|esc(attr) }"
msgstr "{ v|esc(attr) }"

#: ../../source/outgoing/view_parser.rst:381
msgid "excerpt"
msgstr "발췌"

#: ../../source/outgoing/view_parser.rst:381
