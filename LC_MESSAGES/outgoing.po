msgstr "{ v|limit_words(20) }"

#: ../../source/outgoing/view_parser.rst:393
msgid "local_currency"
msgstr "지역_통화"

#: ../../source/outgoing/view_parser.rst:393
msgid "currency, locale, fraction"
msgstr "통화, 로케일, 분수"

#: ../../source/outgoing/view_parser.rst:393
msgid ""
"Displays a localized version of a currency. \"currency\" valueis any "
"3-letter ISO 4217 currency code."
msgstr "통화의 현지화된 버전을 표시합니다. \"통화\" 값은 3자리 ISO 4217 통화 코드입니다."

#: ../../source/outgoing/view_parser.rst:393
