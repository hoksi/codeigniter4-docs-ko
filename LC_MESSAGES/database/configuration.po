msgid "encrypt"
msgstr ""

#: ../../source/database/configuration.rst:224
msgid "MySQLi driver accepts an array with the following options:"
msgstr ""

#: ../../source/database/configuration.rst:226
msgid "``ssl_key``    - Path to the private key file"
msgstr ""

#: ../../source/database/configuration.rst:227
msgid "``ssl_cert``   - Path to the public key certificate file"
msgstr ""

#: ../../source/database/configuration.rst:228
msgid "``ssl_ca``     - Path to the certificate authority file"
msgstr ""

#: ../../source/database/configuration.rst:229
msgid ""
"``ssl_capath`` - Path to a directory containing trusted CA certificates "
"in PEM format"
msgstr ""

#: ../../source/database/configuration.rst:230
msgid ""
"``ssl_cipher`` - List of *allowed* ciphers to be used for the encryption,"
" separated by colons (``:``)"
msgstr ""

#: ../../source/database/configuration.rst:231
msgid ""
"``ssl_verify`` - true/false (boolean) - Whether to verify the server "
"certificate or not"
msgstr ""

