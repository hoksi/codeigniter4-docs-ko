msgstr ""

#: ../../source/general/logging.rst:106
msgid "$_POST variables"
msgstr ""

#: ../../source/general/logging.rst:108
#, python-brace-format
msgid "{get_vars}"
msgstr ""

#: ../../source/general/logging.rst:108
msgid "$_GET variables"
msgstr ""

#: ../../source/general/logging.rst:110
#, python-brace-format
msgid "{session_vars}"
msgstr ""

#: ../../source/general/logging.rst:110
msgid "$_SESSION variables"
msgstr ""

#: ../../source/general/logging.rst:112
#, python-brace-format
msgid "{env}"
msgstr ""

#: ../../source/general/logging.rst:112
msgid "Current environment name, i.e., development"
msgstr ""

#: ../../source/general/logging.rst:114
#, python-brace-format
msgid "{file}"
msgstr ""

#: ../../source/general/logging.rst:114
msgid "The name of file calling the logger"
msgstr ""

#: ../../source/general/logging.rst:116
#, python-brace-format
msgid "{line}"
msgstr ""

#: ../../source/general/logging.rst:116
#, python-brace-format
