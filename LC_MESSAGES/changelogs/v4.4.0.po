#: ../../source/changelogs/v4.4.0.rst:288
msgid "The deprecated Cookie items in **app/Config/App.php** has been removed."
msgstr ""

#: ../../source/changelogs/v4.4.0.rst:289
msgid "The deprecated Session items in **app/Config/App.php** has been removed."
