msgstr ""

#: ../../source/changelogs/v4.2.11.rst:13
msgid "SECURITY"
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:15
msgid ""
"*Attackers may spoof IP address when using proxy* was fixed. See the "
"`Security advisory GHSA-ghw3-5qvm-3mqc "
"<https://github.com/codeigniter4/CodeIgniter4/security/advisories/GHSA-"
"ghw3-5qvm-3mqc>`_ for more information."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:16
msgid ""
"*Potential Session Handlers Vulnerability* was fixed. See the `Security "
"advisory GHSA-6cq5-8cj7-g558 "
"<https://github.com/codeigniter4/CodeIgniter4/security/advisories/GHSA-"
"6cq5-8cj7-g558>`_ for more information."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:19
msgid "BREAKING"
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:21
msgid ""
"The ``Config\\App::$proxyIPs`` value format has been changed. See "
":ref:`Upgrading Guide <upgrade-4211-proxyips>`."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:22
msgid ""
"The key of the session data record for :ref:`sessions-databasehandler-"
"driver`, :ref:`sessions-memcachedhandler-driver` and :ref:`sessions-"
"redishandler-driver` has changed. See :ref:`Upgrading Guide <upgrade-4211"
"-session-key>`."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:27
msgid "Enhancements"
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:29
msgid "Full support for PHP 8.2."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:32
msgid "Bugs Fixed"
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:34
msgid ""
"Fixed a ``FileLocator::locateFile()`` bug where a similar namespace name "
"could be replaced by another, causing a failure to find a file that "
"exists."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:35
msgid ""
"Fixed a ``RedisHandler`` session class to use the correct config when "
"used with a socket connection."
msgstr ""

#: ../../source/changelogs/v4.2.11.rst:37
msgid ""
"See the repo's `CHANGELOG_4.2.md "
"<https://github.com/codeigniter4/CodeIgniter4/blob/develop/changelogs/CHANGELOG_4.2.md>`_"
" for a complete list of bugs fixed."
msgstr ""

