#: ../../source/changelogs/v4.5.8.rst:15
msgid "SECURITY"
msgstr ""

#: ../../source/changelogs/v4.5.8.rst:17
msgid ""
"**Header:** *Validation of header name and value* was fixed. See the "
"`Security advisory GHSA-x5mq-jjr3-vmx6 "
"<https://github.com/codeigniter4/CodeIgniter4/security/advisories/GHSA-"
"x5mq-jjr3-vmx6>`_ for more information."
msgstr ""

#: ../../source/changelogs/v4.5.8.rst:23
msgid "Bugs Fixed"
msgstr ""

#: ../../source/changelogs/v4.5.8.rst:25
msgid ""
"**Database:** Fixed a bug where ``Builder::affectedRows()`` threw an "
"error when the previous query call failed in ``Postgre`` and ``SQLSRV`` "
"drivers."
msgstr ""

#: ../../source/changelogs/v4.5.8.rst:26
msgid ""
"**Security:** Fixed a bug where the CSRF token validation could fail on "
"malformed input, causing a generic HTTP 500 status code instead of "
"handling the input gracefully."
msgstr ""

#: ../../source/changelogs/v4.5.8.rst:28
msgid ""
"See the repo's `CHANGELOG.md "
"<https://github.com/codeigniter4/CodeIgniter4/blob/develop/CHANGELOG.md>`_"
" for a complete list of bugs fixed."
msgstr ""

