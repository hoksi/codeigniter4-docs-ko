msgid "Custom Function Calls"
msgstr "사용자 정의 함수 호출"

#: ../../source/database/call_function.rst:10
msgid "$db->callFunction()"
msgstr "$db->callFunction()\\ 메서드"

#: ../../source/database/call_function.rst:12
